  m_Script: {fileID: 11500000, guid: 77527ea45bc78c341b61f520cf35e03a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RiddleNPC
  promptText: interact
  npcName: The Keeper
  model: {fileID: 0}
  hologramLookOnModel: 1
  hologramColor: {r: 0.2, g: 0.85, b: 1, a: 1}
  introLines:
  - So... you made it through the switches.
  - I am the Keeper of this dimension.
  - Answer my three riddles. Each mistake will cost you in the next room.
  riddles:
  - question: I have keys but open no locks. I have space but no room. You can enter, but you can't go outside.
    options:
    - A keyboard
    - A piano
    - A map
    correctIndex: 0
  - question: The more of me you take, the more you leave behind.
    options:
    - Footsteps
    - Memories
    - Time
    correctIndex: 0
  - question: In the classroom, where did you find the hidden code?
    options:
    - Under a desk
    - Inside a cupboard
    - On the blackboard
    correctIndex: 0
  correctLine: Correct.
  wrongLine: Wrong.
  scoreLine: '{0} out of {1}... {2} will scream for you.'
  outroLines:
  - The way is open. Step into the light by the door.
  afterLine: Go. The way is open.
  computersForScore: 04000000030000000200000001000000i
  portal: {fileID: 847906905}
  onFinished:
    m_PersistentCalls:
      m_Calls: []
  lettersPerSecond: 40
  bobHeight: 0.06
  turnSpeed: 60
  lightRange: 4
  lightIntensity: 1.5
  humVolume: 0.35
  hearingDistance: 10
