  m_Script: {fileID: 11500000, guid: 77527ea45bc78c341b61f520cf35e03a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RiddleNPC
  promptText: interact
  npcName: Lab Asst. Gemini
  model: {fileID: 0}
  hologramLookOnModel: 1
  hologramColor: {r: 0.2, g: 0.85, b: 1, a: 1}
  introLines:
  - Hi, I'm Lab Asst. Gemini. Welcome to the CAD lab.
  - Some of the computers in here are faulty, and they need fixing before class.
  - Answer three questions to proceed. Every wrong answer means more computers to fix.
  riddles:
  - question: Which type of testing is performed after coding every module?
    options:
    - Unit testing
    - Integration testing
    - Acceptance testing
    correctIndex: 0
  - question: Which software development life cycle model uses pair programming?
    options:
    - Extreme Programming
    - Lean
    - Waterfall
    correctIndex: 0
  - question: Which testing technique involves examining the internal code structure without executing the program?
    options:
    - Static testing
    - Dynamic testing
    - Performance testing
    correctIndex: 0
  correctLine: Correct.
  wrongLine: 'Not quite. The answer is: {0}.'
  scoreLine: '{0} out of {1} correct. You''ll need to fix {2}.'
  outroLines:
  - Head through the portal when you're ready. The faulty computers are in Lab 1.
  afterLine: The faulty computers are in Lab 1, through the portal.
  computersForScore: 06000000050000000400000003000000i
  portal: {fileID: 847906905}
  onFinished:
    m_PersistentCalls:
      m_Calls: []
  lettersPerSecond: 40
  bobHeight: 0.06
  turnSpeed: 60
  lightRange: 4
  lightIntensity: 1.5
  humVolume: 0.35
  hearingDistance: 10
